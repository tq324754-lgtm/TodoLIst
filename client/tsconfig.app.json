{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": ["env.d.ts", "client/src/**/*", "client/src/**/*.vue"],
  "exclude": ["client/src/**/__tests__/*"],
  "compilerOptions": {
    "noUncheckedIndexedAccess": true,
    "target": "ES2020",
    "lib": ["ES2020", "DOM"],
    "paths": {
      "@/*": ["./client/src/*"]
    },

    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo"
  }
}
